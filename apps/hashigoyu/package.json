{
  "name": "hashigoyu",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "build": "pnpm -r build",
    "deploy": "pnpm deploy:prepare && wrangler deploy",
    "deploy:dry-run": "pnpm deploy:prepare && wrangler deploy --dry-run",
    "deploy:prepare": "pnpm build && node scripts/prepare-cloudflare.mjs",
    "dev": "pnpm --parallel --filter guest --filter counter --filter admin dev",
    "e2e": "playwright test",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r exec tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "wrangler": "^4.127.0"
  }
}
